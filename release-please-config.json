{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "pull-request-title-pattern": "chore(release): release ${version}",
  "group-pull-request-title-pattern": "chore(release): release ${branch}",
  "packages": {
    "packages/rust-core": {
      "release-type": "rust",
      "package-name": "sarvam-rust-core",
      "component": "rust-core",
      "extra-files": [
        "README.md"
      ]
    },
    "packages/kotlin": {
      "release-type": "maven",
      "package-name": "sarvam-core",
      "component": "kotlin",
      "extra-files": [
        "packages/kotlin/README.md",
        "README.md"
      ]
    },
    "packages/swift": {
      "release-type": "simple",
      "package-name": "Sarvam",
      "component": "swift",
      "extra-files": [
        "packages/swift/README.md",
        "README.md"
      ]
    },
    "packages/ts-core": {
      "release-type": "node",
      "package-name": "@sarvam-mobile/core",
      "component": "ts-core"
    },
    "packages/react-native": {
      "release-type": "node",
      "package-name": "@sarvam-mobile/react-native",
      "component": "react-native"
    },
    "packages/dart/sarvam": {
      "release-type": "dart",
      "package-name": "sarvam",
      "component": "dart",
      "extra-files": [
        "packages/dart/sarvam/README.md",
        "README.md"
      ]
    },
    "packages/dart/sarvam_flutter_audio": {
      "release-type": "dart",
      "package-name": "sarvam_flutter_audio",
      "component": "dart-audio",
      "extra-files": [
        "packages/dart/sarvam_flutter_audio/README.md",
        "README.md"
      ]
    }
  }
}
